{
  "compilerOptions": {
    "target": "ES2022", "lib": ["dom", "dom.iterable", "esnext"],
    "strict": true, "noUncheckedIndexedAccess": true, "skipLibCheck": true,
    "module": "esnext", "moduleResolution": "bundler", "jsx": "preserve",
    "isolatedModules": true, "noEmit": true, "incremental": true,
    "plugins": [{ "name": "next" }],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
